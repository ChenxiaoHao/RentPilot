# Optional API base INCLUDING /api. Never put model keys or AMap securityJsCode in VITE_*.
# Browser defaults to /api (Vite proxies to http://127.0.0.1:8080).
# Android local debug defaults to http://10.0.2.2:8080/api (Android emulator host).
# VITE_API_BASE_URL=https://your-api.example.com/api
# AMap JS API Web Key is public and is included in the client bundle.
# VITE_AMAP_WEB_KEY=your_web_key
# Development Vite proxy target can also be set in the terminal before npm run dev:
# RENTPILOT_API_PROXY_TARGET=http://127.0.0.1:8080
